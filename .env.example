# ========================================================
# FitAI Environment Variables Template
# ========================================================
# Instructions:
# 1. Copy or rename this file to `.env`:
#      cp .env.example .env
# 2. Replace the placeholder values below with your credentials.
# 3. Never commit your `.env` file with real credentials to GitHub.
# ========================================================

# Google Gemini API Key
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Project Credentials
# Get your project credentials at: https://supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
